{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chronos: Run in Ubuntu",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/chronos",
      "args": ["8080"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Chronos: build"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    }
  ]
}